# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Model Configuration (optional - has defaults)
MODEL_URL=https://github.com/EthanMcKanna/waymo-counter/releases/download/v1.1/best.pt
MODEL_IMAGE_SIZE=640

# Detection Configuration (optional - has defaults)
CONFIDENCE_THRESHOLD=0.70
VERIFIER_ENABLED=false
VERIFIER_MODEL_URL=https://github.com/EthanMcKanna/waymo-counter/releases/download/v1.2/verifier.torchscript.pt
VERIFIER_IMAGE_SIZE=224
VERIFIER_CROP_PADDING=0.35
VERIFIER_CALIBRATION_ENABLED=false
VERIFIER_THRESHOLD=0.475
VERIFIER_NON_AUSTIN_THRESHOLD=0.90
FETCH_WORKERS=16
SCAN_SCOPE=all
ENABLED_MARKETS=austin,san_antonio,dallas,houston,atlanta,orlando,miami,phoenix
